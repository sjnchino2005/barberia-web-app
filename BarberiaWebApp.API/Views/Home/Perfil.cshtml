@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal del Cliente - Barbería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #121212;
            color: #f8f9fa;
        }

        .card-custom {
            background-color: #1e1e1e;
            border: 1px solid #333;
        }

        .gold-text {
            color: #d4af37;
        }

        /* Estilos de los sellos digitales */
        .stamp-box {
            width: 55px;
            height: 55px;
            border: 2px dashed #d4af37;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin: auto;
            transition: all 0.3s ease;
        }

        .stamp-active {
            background-color: #d4af37;
            color: #121212;
            border-style: solid;
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
        }
    </style>
</head>
<body class="py-4">
    <div class="container">
        <!-- Header Perfil -->
        <div class="card card-custom p-4 mb-4 text-center">
            <h2 id="clienteNombre" class="gold-text fw-bold">Cargando...</h2>
            <p class="text-muted mb-1" id="clienteContacto"></p>
            <div class="mt-2">
                <span class="badge bg-warning text-dark fs-6">Puntos Acumulados: <strong id="clientePuntos">0</strong> pts</span>
            </div>
        </div>

        <!-- Tarjeta de Fidelidad Digital -->
        <div class="card card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="gold-text mb-0"><i class="bi bi-card-checklist me-2"></i>Tarjeta Club VIP</h4>
                <span class="badge bg-success" id="premioStatus">Corte #6 Gratis</span>
            </div>
            <p class="text-muted small">Completa 6 visitas para obtener un 50% de descuento o un corte gratis en tu próxima cita.</p>

            <div class="row text-center g-3 my-2" id="gridSellos">
                <!-- Se renderiza mediante JavaScript -->
            </div>
        </div>

        <!-- Historial de Cortes -->
        <h4 class="mb-3"><i class="bi bi-clock-history me-2"></i>Historial de Visitas Pasadas</h4>
        <div id="historialCortes" class="row g-3">
            <div class="col-12 text-center text-muted">Cargando historial...</div>
        </div>
    </div>

    <script>
        const clienteId = 1;

        // Cargar Perfil
        fetch(`/api/clientes/${clienteId}/perfil`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('clienteNombre').innerText = data.nombreCompleto;
                document.getElementById('clienteContacto').innerText = `${data.telefono} | ${data.email}`;
                document.getElementById('clientePuntos').innerText = data.puntosAcumulados;
            });

        // Cargar Historial y Renderizar Sellos de Fidelidad
        fetch(`/api/clientes/${clienteId}/historial`)
            .then(res => res.json())
            .then(data => {
                const totalCortes = data.length;
                const sellosAcumulados = totalCortes % 6; // Ciclo de 6 sellos

                // Renderizar Sellos
                const gridSellos = document.getElementById('gridSellos');
                gridSellos.innerHTML = '';

                for (let i = 1; i <= 6; i++) {
                    const esActivo = i <= (sellosAcumulados === 0 && totalCortes > 0 ? 6 : sellosAcumulados);
                    gridSellos.innerHTML += `
                        <div class="col-4 col-md-2">
                            <div class="stamp-box ${esActivo ? 'stamp-active' : ''}">
                                ${esActivo ? '<i class="bi bi-scissors"></i>' : i}
                            </div>
                            <small class="d-block mt-1 text-muted">Corte ${i}</small>
                        </div>
                    `;
                }

                // Renderizar Lista de Cortes
                const contenedor = document.getElementById('historialCortes');
                contenedor.innerHTML = '';

                if (data.length === 0) {
                    contenedor.innerHTML = '<div class="col-12 text-muted">No hay cortes registrados.</div>';
                    return;
                }

                data.forEach(corte => {
                    const fecha = new Date(corte.fechaServicio).toLocaleDateString('es-BO');
                    contenedor.innerHTML += `
                        <div class="col-md-6">
                            <div class="card card-custom p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="gold-text mb-0">${corte.tipoCorte}</h5>
                                    <span class="badge bg-secondary">${corte.precioBs} Bs</span>
                                </div>
                                <small class="text-muted mt-1">Fecha: ${fecha}</small>
                                <p class="mt-2 mb-0 text-light"><strong>Nota del barbero:</strong> ${corte.notasTecnicas || 'Sin notas'}</p>
                            </div>
                        </div>
                    `;
                });
            });
    </script>
</body>
</html>