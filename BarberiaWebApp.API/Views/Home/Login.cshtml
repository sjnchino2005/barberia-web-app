@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Barbería Web App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #0d1117;
            color: #f0f6fc;
        }

        .card-custom {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            max-width: 420px;
            width: 100%;
        }

        .gold-text {
            color: #d4af37;
        }

        .btn-gold {
            background-color: #d4af37;
            color: #0d1117;
            font-weight: bold;
            border: none;
        }

            .btn-gold:hover {
                background-color: #b5932b;
                color: #0d1117;
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">
    <div class="card card-custom p-4 shadow-lg">
        <div class="text-center mb-4">
            <h2 class="gold-text fw-bold"><i class="bi bi-scissors me-2"></i>Barbería VIP</h2>
            <p class="text-muted small">Ingresa tus credenciales para acceder</p>
        </div>

        <div id="errorMsg" class="alert alert-danger d-none py-2 text-center" role="alert"></div>

        <div class="mb-3">
            <label class="form-label text-muted">Usuario</label>
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-person"></i></span>
                <input type="text" id="txtUsername" class="form-control bg-dark text-light border-secondary" placeholder="ej. admin, barbero1">
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted">Contraseña</label>
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-lock"></i></span>
                <input type="password" id="txtPassword" class="form-control bg-dark text-light border-secondary" value="123">
            </div>
        </div>

        <button onclick="ingresar()" class="btn btn-gold w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión</button>

        <div class="mt-4 pt-3 border-top border-secondary text-center text-muted small">
            <p class="mb-1"><strong>Usuarios de prueba (Password: 123):</strong></p>
            <span class="badge bg-secondary me-1">admin</span>
            <span class="badge bg-secondary me-1">barbero1</span>
            <span class="badge bg-secondary">cliente1</span>
        </div>
    </div>

    <script>
        function ingresar() {
            const user = document.getElementById('txtUsername').value.trim();
            const pass = document.getElementById('txtPassword').value.trim();
            const errDiv = document.getElementById('errorMsg');

            if (!user || !pass) {
                errDiv.innerText = 'Ingresa el usuario y contraseña';
                errDiv.classList.remove('d-none');
                return;
            }

            fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: user, password: pass })
            })
            .then(res => {
                if (!res.ok) throw new Error('Usuario o contraseña incorrectos');
                return res.json();
            })
            .then(data => {
                // Guardar la sesión en el navegador
                localStorage.setItem('usuarioSesion', JSON.stringify(data));

                // Redirección inteligente según el Rol
                if (data.rol === 'Admin' || data.rol === 'Barbero') {
                    window.location.href = '/barbero';
                } else {
                    window.location.href = '/cliente/perfil';
                }
            })
            .catch(err => {
                errDiv.innerText = err.message;
                errDiv.classList.remove('d-none');
            });
        }
    </script>
</body>
</html>