@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración, Inventario y Reportes - Barbería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #121212;
            color: #f8f9fa;
        }

        .card-custom {
            background-color: #1e1e1e;
            border: 1px solid #333;
        }

        .gold-text {
            color: #d4af37;
        }
    </style>
</head>
<body class="py-4">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="gold-text fw-bold mb-0"><i class="bi bi-speedometer2 me-2"></i>Panel Ejecutivo & Control</h2>
            <div>
                <a href="/barbero" class="btn btn-outline-light btn-sm me-2">Turnero</a>
                <button onclick="cerrarSesion()" class="btn btn-danger btn-sm">Salir</button>
            </div>
        </div>

        <!-- KPIs Reporte Mensual (SCRUM-24) -->
        <h5 class="text-muted mb-3 text-uppercase">Resumen Financiero (<span id="lblMes">Mes Actual</span>)</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card card-custom p-3 text-center">
                    <small class="text-muted">Ingresos del Mes</small>
                    <h3 class="text-success fw-bold mb-0" id="kpiIngresos">0 Bs</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-custom p-3 text-center">
                    <small class="text-muted">Cortes Realizados</small>
                    <h3 class="gold-text fw-bold mb-0" id="kpiServicios">0</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-custom p-3 text-center">
                    <small class="text-muted">Ticket Promedio</small>
                    <h3 class="text-info fw-bold mb-0" id="kpiPromedio">0 Bs</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-custom p-3 text-center">
                    <small class="text-muted">Alertas Stock Bajo</small>
                    <h3 class="text-danger fw-bold mb-0" id="kpiAlertas">0</h3>
                </div>
            </div>
        </div>

        <!-- Inventario y Desglose Mensual -->
        <div class="row g-4 mb-4">
            <!-- Control de Inventario (SCRUM-23) -->
            <div class="col-md-7">
                <div class="card card-custom p-4 h-100">
                    <h4 class="gold-text mb-3"><i class="bi bi-box-seam me-2"></i>Inventario y Alertas de Stock</h4>
                    <div class="row g-2 mb-3">
                        <div class="col-4"><input type="text" id="pNombre" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Producto"></div>
                        <div class="col-3"><input type="number" id="pPrecio" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Precio (Bs)"></div>
                        <div class="col-2"><input type="number" id="pStock" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Stock"></div>
                        <div class="col-3"><button onclick="agregarProducto()" class="btn btn-warning btn-sm w-100 fw-bold">+ Producto</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm align-middle">
                            <thead><tr><th>Producto</th><th>Precio</th><th>Stock</th><th>Estado</th><th>Ajustar</th></tr></thead>
                            <tbody id="listaProductos"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Desglose de Ingresos por Servicio -->
            <div class="col-md-5">
                <div class="card card-custom p-4 h-100">
                    <h4 class="gold-text mb-3"><i class="bi bi-bar-chart-line me-2"></i>Ingresos por Servicio</h4>
                    <table class="table table-dark table-sm">
                        <thead><tr><th>Servicio</th><th>Cant.</th><th>Total (Bs)</th></tr></thead>
                        <tbody id="listaDesglose"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gestión de Barberos y Precios (SCRUM-22) -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <h5 class="gold-text mb-3">Barberos del Local</h5>
                    <div class="row g-2 mb-3">
                        <div class="col-5"><input type="text" id="bNombre" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Nombre"></div>
                        <div class="col-4"><input type="text" id="bEsp" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Especialidad"></div>
                        <div class="col-3"><button onclick="agregarBarbero()" class="btn btn-warning btn-sm w-100 fw-bold">+ Agregar</button></div>
                    </div>
                    <table class="table table-dark table-sm">
                        <thead><tr><th>Nombre</th><th>Especialidad</th><th>Acción</th></tr></thead>
                        <tbody id="listaBarberos"></tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <h5 class="gold-text mb-3">Catálogo de Servicios (Bs)</h5>
                    <div class="row g-2 mb-3">
                        <div class="col-5"><input type="text" id="sNombre" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Servicio"></div>
                        <div class="col-4"><input type="number" id="sPrecio" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Precio (Bs)"></div>
                        <div class="col-3"><button onclick="agregarServicio()" class="btn btn-warning btn-sm w-100 fw-bold">+ Agregar</button></div>
                    </div>
                    <table class="table table-dark table-sm">
                        <thead><tr><th>Servicio</th><th>Precio</th><th>Acción</th></tr></thead>
                        <tbody id="listaServicios"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sesion = JSON.parse(localStorage.getItem('usuarioSesion') || 'null');
        if (!sesion || sesion.rol !== 'Admin') {
            alert('Acceso denegado. Solo el Administrador puede entrar aquí.');
            window.location.href = '/login';
        }

        function cerrarSesion() {
            localStorage.removeItem('usuarioSesion');
            window.location.href = '/login';
        }

        function cargarTodo() {
            // Reporte Mensual
            fetch('/api/administracion/reporte-mensual').then(r => r.json()).then(rep => {
                document.getElementById('lblMes').innerText = rep.mes;
                document.getElementById('kpiIngresos').innerText = `${rep.totalIngresosBs} Bs`;
                document.getElementById('kpiServicios').innerText = rep.totalServicios;
                document.getElementById('kpiPromedio').innerText = `${rep.ticketPromedioBs} Bs`;
                document.getElementById('kpiAlertas').innerText = rep.productosBajoStock;

                document.getElementById('listaDesglose').innerHTML = rep.desgloseServicios.length
                    ? rep.desgloseServicios.map(d => `<tr><td>${d.servicio}</td><td>${d.cantidad}</td><td><strong>${d.subtotalBs} Bs</strong></td></tr>`).join('')
                    : '<tr><td colspan="3" class="text-muted">Sin movimientos este mes</td></tr>';
            });

            // Productos / Inventario
            fetch('/api/administracion/productos').then(r => r.json()).then(data => {
                document.getElementById('listaProductos').innerHTML = data.map(p => {
                    const bajo = p.stockActual <= p.stockMinimo;
                    return `<tr>
                        <td>${p.nombre}</td>
                        <td>${p.precioVentaBs} Bs</td>
                        <td><strong>${p.stockActual}</strong></td>
                        <td>${bajo ? '<span class="badge bg-danger">Stock Bajo</span>' : '<span class="badge bg-success">OK</span>'}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-success py-0" onclick="ajustarStock(${p.id}, 1)">+</button>
                            <button class="btn btn-sm btn-outline-warning py-0" onclick="ajustarStock(${p.id}, -1)">-</button>
                        </td>
                    </tr>`;
                }).join('');
            });

            // Barberos
            fetch('/api/administracion/barberos').then(r => r.json()).then(data => {
                document.getElementById('listaBarberos').innerHTML = data.map(b => `
                    <tr><td>${b.nombreCompleto}</td><td>${b.especialidad}</td>
                    <td><button class="btn btn-sm btn-outline-danger py-0" onclick="eliminarBarbero(${b.id})">X</button></td></tr>`).join('');
            });

            // Servicios
            fetch('/api/administracion/servicios').then(r => r.json()).then(data => {
                document.getElementById('listaServicios').innerHTML = data.map(s => `
                    <tr><td>${s.nombre}</td><td><strong>${s.precioBs} Bs</strong></td>
                    <td><button class="btn btn-sm btn-outline-danger py-0" onclick="eliminarServicio(${s.id})">X</button></td></tr>`).join('');
            });
        }

        function agregarProducto() {
            const body = {
                nombre: document.getElementById('pNombre').value,
                precioVentaBs: parseFloat(document.getElementById('pPrecio').value) || 0,
                stockActual: parseInt(document.getElementById('pStock').value) || 0,
                stockMinimo: 5
            };
            if (!body.nombre) return;
            fetch('/api/administracion/productos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(() => { document.getElementById('pNombre').value = ''; document.getElementById('pPrecio').value = ''; document.getElementById('pStock').value = ''; cargarTodo(); });
        }

        function ajustarStock(id, delta) {
            fetch(`/api/administracion/productos/${id}/stock`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(delta) })
                .then(() => cargarTodo());
        }

        function agregarBarbero() {
            const body = { nombreCompleto: document.getElementById('bNombre').value, especialidad: document.getElementById('bEsp').value };
            if (!body.nombreCompleto) return;
            fetch('/api/administracion/barberos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(() => { document.getElementById('bNombre').value = ''; document.getElementById('bEsp').value = ''; cargarTodo(); });
        }

        function eliminarBarbero(id) {
            fetch(`/api/administracion/barberos/${id}`, { method: 'DELETE' }).then(() => cargarTodo());
        }

        function agregarServicio() {
            const body = { nombre: document.getElementById('sNombre').value, precioBs: parseFloat(document.getElementById('sPrecio').value) || 0 };
            if (!body.nombre) return;
            fetch('/api/administracion/servicios', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(() => { document.getElementById('sNombre').value = ''; document.getElementById('sPrecio').value = ''; cargarTodo(); });
        }

        function eliminarServicio(id) {
            fetch(`/api/administracion/servicios/${id}`, { method: 'DELETE' }).then(() => cargarTodo());
        }

        cargarTodo();
    </script>
</body>
</html>