@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Barbero</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121212;
            color: #f8f9fa;
        }

        .card-custom {
            background-color: #1e1e1e;
            border: 1px solid #333;
        }

        .gold-text {
            color: #d4af37;
        }
    </style>
</head>
<body class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="gold-text font-weight-bold">Panel Operativo de Barberos</h2>
            <a href="/turnero" target="_blank" class="btn btn-outline-warning">Abrir Pantalla Turnero</a>
        </div>

        <div class="card card-custom p-4">
            <h4 class="mb-3">Cola de Turnos del Día</h4>
            <div class="table-responsive">
                <table class="table table-dark table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Barbero</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaTurnos">
                        <tr><td colspan="5" class="text-center text-muted">Cargando turnos...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function cargarTabla() {
            fetch('/api/turnos/activos')
                .then(res => res.json())
                .then(data => {
                    const tbody = document.getElementById('tablaTurnos');
                    tbody.innerHTML = '';

                    if (data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No hay turnos activos.</td></tr>';
                        return;
                    }

                    data.forEach(t => {
                        let btnAccion = '';
                        if (t.estado === 'En espera') {
                            btnAccion = `<button class="btn btn-sm btn-success" onclick="cambiarEstado(${t.id}, 'En atencion')">Atender Cliente</button>`;
                        } else if (t.estado === 'En atencion') {
                            btnAccion = `<button class="btn btn-sm btn-primary" onclick="cambiarEstado(${t.id}, 'Completado')">Finalizar Corte</button>`;
                        }

                        tbody.innerHTML += `
                            <tr>
                                <td><strong>${t.nombreCliente}</strong></td>
                                <td>${t.barberoAsignado}</td>
                                <td>${t.servicio}</td>
                                <td><span class="badge ${t.estado === 'En atencion' ? 'bg-success' : 'bg-warning text-dark'}">${t.estado}</span></td>
                                <td>${btnAccion}</td>
                            </tr>
                        `;
                    });
                });
        }

        function cambiarEstado(id, nuevoEstado) {
            fetch(`/api/turnos/${id}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(nuevoEstado)
            }).then(() => cargarTabla());
        }

        cargarTabla();
    </script>
</body>
</html>