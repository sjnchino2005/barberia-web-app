@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turnero en Vivo - Barbería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #0d1117;
            color: #f0f6fc;
        }

        .card-panel {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
        }

        .gold-text {
            color: #d4af37;
        }

        .badge-atencion {
            background-color: #238636;
            font-size: 1.1rem;
        }

        .badge-espera {
            background-color: #d29922;
            color: #0d1117;
            font-size: 1rem;
        }
    </style>
</head>
<body class="py-4">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h1 class="gold-text fw-bold mb-0"><i class="bi bi-scissors me-2"></i>Turnero en Vivo</h1>
            <span class="fs-5 text-muted"><i class="bi bi-tv me-2"></i>Pantalla Sala de Espera</span>
        </div>

        <div class="row g-4">
            <!-- En Atención -->
            <div class="col-md-6">
                <div class="card card-panel p-4 h-100">
                    <h3 class="text-success mb-3"><i class="bi bi-play-circle-fill me-2"></i>En Atención Actual</h3>
                    <div id="listaAtencion" class="row g-3">
                        <div class="col-12 text-muted">Cargando barberos...</div>
                    </div>
                </div>
            </div>

            <!-- En Espera -->
            <div class="col-md-6">
                <div class="card card-panel p-4 h-100">
                    <h3 class="gold-text mb-3"><i class="bi bi-people-fill me-2"></i>Próximos Turnos (En Espera)</h3>
                    <div id="listaEspera" class="list-group list-group-flush">
                        <div class="text-muted">Cargando cola de espera...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function cargarTurnos() {
            fetch('/api/turnos/activos')
                .then(res => res.json())
                .then(data => {
                    const contAtencion = document.getElementById('listaAtencion');
                    const contEspera = document.getElementById('listaEspera');

                    contAtencion.innerHTML = '';
                    contEspera.innerHTML = '';

                    const enAtencion = data.filter(t => t.estado === 'En atencion');
                    const enEspera = data.filter(t => t.estado === 'En espera');

                    if (enAtencion.length === 0) {
                        contAtencion.innerHTML = '<div class="text-muted p-3">No hay clientes en atención en este momento.</div>';
                    } else {
                        enAtencion.forEach(t => {
                            contAtencion.innerHTML += `
                                <div class="col-12">
                                    <div class="p-3 border border-success rounded bg-dark d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 class="gold-text mb-1">${t.nombreCliente}</h4>
                                            <span class="text-muted">Barbero: <strong>${t.barberoAsignado}</strong> | ${t.servicio}</span>
                                        </div>
                                        <span class="badge badge-atencion px-3 py-2">En Silla</span>
                                    </div>
                                </div>
                            `;
                        });
                    }

                    if (enEspera.length === 0) {
                        contEspera.innerHTML = '<div class="text-muted p-3">No hay turnos en espera.</div>';
                    } else {
                        enEspera.forEach((t, i) => {
                            contEspera.innerHTML += `
                                <div class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <h5 class="mb-1">#${i + 1} - ${t.nombreCliente}</h5>
                                        <small class="text-muted">Barbero: ${t.barberoAsignado} (${t.servicio})</small>
                                    </div>
                                    <span class="badge badge-espera">En Espera</span>
                                </div>
                            `;
                        });
                    }
                });
        }

        cargarTurnos();
        setInterval(cargarTurnos, 5000); // Refresca cada 5 segundos
    </script>
</body>
</html>